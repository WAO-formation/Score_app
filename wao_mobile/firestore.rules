rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPERS ====================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reads the caller's own profile to find their role (fan/official/admin).
    // Costs one extra read per rule evaluation but needs no separate
    // custom-claims pipeline to stand up right now.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'admin';
    }

    // Officials (mobile live-scoring) and moderators (wao-web back office)
    // sit at the same Firestore write tier; admins can do everything either
    // can, plus the admin-only actions below. Which humans get *into*
    // wao-web at all (admin/moderator only, not official) is a separate,
    // app-level gate in wao-web's AuthContext — not something rules decide.
    function isOfficial() {
      return isSignedIn() && (callerRole() == 'official' || callerRole() == 'moderator' || callerRole() == 'admin');
    }

    function callerTeamId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId;
    }

    // A coach may manage the roster of *their own* team only (users/{uid}.
    // teamId, the same admin-assigned link TeamActivitiesPage reads on
    // mobile) — not any other team, and not match/score data, which stays
    // isOfficial()-only.
    function isCoachOfTeam(teamId) {
      return isSignedIn() && callerRole() == 'coach' && callerTeamId() == teamId;
    }

    // Mirrors WaoTeam.maxSquadSize (wao_mobile/lib/Model/teams_games/wao_team.dart)
    // and TeamRoster.totalPlayers — that 12-player cap was previously only
    // ever checked client-side, so a modified client (or any future code
    // path writing `roster` directly) could write an unlimited squad.
    function rosterSize(roster) {
      return roster.get('kingIds', []).size()
           + roster.get('workerIds', []).size()
           + roster.get('protagueIds', []).size()
           + roster.get('antagueIds', []).size()
           + roster.get('warriorIds', []).size()
           + roster.get('sacrificerIds', []).size()
           + roster.get('servitorIds', []).size()
           + roster.get('substituteIds', []).size();
    }

    // True once at least `seconds` have passed since the document's last
    // recorded write. Acts as a per-document cooldown — the closest thing
    // to rate limiting Firestore rules can do without a Cloud Function
    // holding server-side counters. Missing/legacy docs (no updatedAt yet)
    // pass once, then fall under the cooldown from their first stamped write.
    function pastCooldown(existingData, seconds) {
      return request.time > existingData.get('updatedAt', timestamp.date(2000, 1, 1)) + duration.value(seconds, 's');
    }

    // The write must itself stamp updatedAt with the server time — stops a
    // client from writing a stale/fake updatedAt to dodge the cooldown.
    function stampsServerTime() {
      return request.resource.data.updatedAt == request.time;
    }

    // ==================== USERS ====================

    match /users/{userId} {
      // isOfficial() already includes isAdmin() — widened from admin-only
      // so a moderator creating a game can query for other moderator/
      // official accounts to assign as judges (Management > Games needs
      // this same lookup; a `where('role', '==', ...)` query is rejected
      // outright by Firestore rules unless it can hold for every possible
      // matching doc, not just the caller's own).
      allow read: if isOwner(userId) || isOfficial();

      // Self-registration: a user may create only their own profile, and
      // only as the default 'fan' role — nobody can hand themselves a
      // privileged role at signup. An admin may instead create a profile
      // for *someone else's* uid with any role — that's how wao-web's
      // "Add User" (Management > Users) provisions moderators/officials:
      // the Auth account is created first, then this doc, while still
      // signed in as the admin.
      allow create: if (isOwner(userId) && request.resource.data.role == 'fan')
                    || isAdmin();

      // Self-service update: owner can edit their own display/preference
      // fields, but role and createdAt aren't in the allow-list, so any
      // attempt to touch them fails the whole write. An admin can still
      // update anything (e.g. to grant a role).
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly([
                               'username', 'email', 'displayName', 'photoUrl',
                               'phone', 'bio', 'mustChangePassword',
                               'favoriteTeamIds', 'favoriteMatchIds',
                               'totalMatches', 'totalTeams', 'themePreference',
                               'notificationsEnabled', 'emailNotifications',
                               'language', 'fcmToken', 'updatedAt',
                             ]));

      allow delete: if isAdmin();

      match /followedTeams/{teamId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==================== TEAMS ====================

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create, delete: if isOfficial();

      // A coach may only ever touch their own team's roster field — name,
      // category, coach/secretary/director etc. stay isOfficial()-only.
      // The 12-player cap applies to anyone writing `roster`, admin/official
      // included — this is a squad-size rule, not a coach-specific one.
      allow update: if (isOfficial()
                        || (isCoachOfTeam(teamId)
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['roster', 'updatedAt'])))
                    && rosterSize(request.resource.data.roster) <= 12;
    }

    match /teamStatistics/{teamId} {
      allow read: if isSignedIn();

      // Win/loss/goals now come from the onMatchFinished Cloud Function
      // (Admin SDK, bypasses these rules) so no client can hand-edit them.
      // totalFollowers is carved out separately because following a team is
      // an ordinary-fan action (TeamService.updateFollowerCount), not an
      // officiating one. activePlayers/inactivePlayers is carved out for a
      // coach too — TeamService recomputes those right after a roster edit
      // (add/removePlayerFromTeam), which a coach is now allowed to do.
      allow update: if isOfficial()
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['totalFollowers', 'updatedAt']))
                    || (isCoachOfTeam(teamId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['activePlayers', 'inactivePlayers', 'updatedAt']));
      allow create: if isOfficial();
      allow delete: if isOfficial();
    }

    match /teams/{teamId}/followers/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // ==================== PLAYERS ====================

    match /players/{playerId} {
      allow read: if isSignedIn();
      allow delete: if isOfficial();

      // A coach may create a player doc only for their own team, and edit
      // an existing player only via the same fields TeamService's
      // add/removePlayerFromTeam and updatePlayerRole/Status actually
      // write. Stats fields (gamesPlayed etc.) stay Cloud-Function/
      // admin-only. Joining is only allowed from unassigned
      // (resource.currentTeamId == null) — a coach can't poach a player
      // who's already on a *different* team; that stays isOfficial().
      allow create: if isOfficial()
                    || (isSignedIn() && callerRole() == 'coach'
                        && request.resource.data.currentTeamId == callerTeamId());
      allow update: if isOfficial()
                    || (isSignedIn() && callerRole() == 'coach'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['currentTeamId', 'currentTeamName', 'joinedTeamAt',
                                       'role', 'status', 'jerseyNumber', 'age', 'updatedAt'])
                        && (resource.data.currentTeamId == callerTeamId()
                            || (resource.data.currentTeamId == null
                                && request.resource.data.currentTeamId == callerTeamId())));
    }

    // ==================== MATCHES ====================

    match /matches/{matchId} {
      allow read: if isSignedIn();

      // Admin-only: creating a match assigns a moderator to run it and
      // judges to officiate it, which is an admin decision — a moderator
      // only ever operates a match already assigned to them (wao-web's
      // CreateGamePage is hidden from non-admins for the same reason).
      allow create: if isAdmin()
                    && request.resource.data.scoreA == 0
                    && request.resource.data.scoreB == 0
                    && 'moderatorUid' in request.resource.data
                    && request.resource.data.moderatorUid is string
                    && request.resource.data.moderatorUid.size() > 0
                    && stampsServerTime();

      // Split into three update shapes rather than one blanket "official can
      // write anything": scoring/status changes are restricted to an admin
      // or the specific moderator assigned to *this* match (moderatorUid,
      // set at creation) — not just any official-tier account, since the
      // web simulate screen has no other gate keeping a moderator out of a
      // match they weren't assigned. A plain official assigned as a *judge*
      // (judgeUids, kept in sync with the judges array — see matchesService)
      // gets a narrower third branch: only the Judges-category score, and
      // only while the match is live, so their wao-web "My Officiating" page
      // can grant that one score without needing moderator-tier access.
      // Favoriting is a self-service action open to any signed-in user but
      // can only ever touch the isFavorite field.
      allow update: if
        (isOfficial()
          && (isAdmin() || resource.data.moderatorUid == request.auth.uid)
          && stampsServerTime()
          && pastCooldown(resource.data, 2)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'scoreA', 'scoreB', 'status', 'statusReason', 'previousStatus',
                 'teamAKingdom', 'teamBKingdom',
                 'teamAWorkout', 'teamBWorkout',
                 'teamAGoalSetting', 'teamBGoalSetting',
                 'teamAJudges', 'teamBJudges',
                 'quarters', 'fouls', 'events', 'currentQuarter', 'timeRemaining', 'isPlaying',
                 'moderatorUid', 'moderatorName', 'judges', 'judgeUids', 'completedAt', 'championshipName',
                 'startTime', 'venue', 'liveStartedAt',
                 'updatedAt',
               ])
          && request.resource.data.scoreA is int && request.resource.data.scoreA >= 0 && request.resource.data.scoreA <= 999
          && request.resource.data.scoreB is int && request.resource.data.scoreB >= 0 && request.resource.data.scoreB <= 999)
        ||
        (isSignedIn()
          && callerRole() == 'official'
          && ('judgeUids' in resource.data) && resource.data.judgeUids.hasAny([request.auth.uid])
          && resource.data.status == 'live'
          && stampsServerTime()
          && pastCooldown(resource.data, 2)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamAJudges', 'teamBJudges', 'updatedAt'])
          && request.resource.data.teamAJudges is int && request.resource.data.teamAJudges >= 0 && request.resource.data.teamAJudges <= 999
          && request.resource.data.teamBJudges is int && request.resource.data.teamBJudges >= 0 && request.resource.data.teamBJudges <= 999)
        ||
        (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isFavorite']));

      allow delete: if isOfficial();

      match /private/access {
        // accessCode is how a game gets started/simulated. Anyone signed-in can
        // read the parent matches doc, so the code can't live there — only an
        // admin or the specific moderator assigned to *this* match may read it.
        allow read: if isAdmin()
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/matches/$(matchId)).data.moderatorUid == request.auth.uid);
        allow write: if isOfficial();
      }
    }

    // ==================== CHAMPIONSHIPS ====================

    match /championships/{championshipId} {
      allow read: if isSignedIn();
      // Higher-stakes, low-frequency writes — admin only, not officials.
      allow create, update, delete: if isAdmin();
    }

    // ==================== VENUES ====================

    match /venues/{venueId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ==================== REPORTS ====================

    match /reports/{reportId} {
      // Internal officiating/incident reports — not fan-facing, unlike the
      // other collections above that intentionally use isSignedIn().
      allow read: if isOfficial();
      allow create, update: if isOfficial();
      allow delete: if isAdmin();
    }

    // ==================== NEWS ====================

    match /news/{newsId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — authenticated users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null;
      
      // followedTeams subcollection
      match /followedTeams/{teamId} {
        allow read, write: if request.auth != null;
      }
    }

    // Teams — anyone authenticated can read, write allowed for seeding
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    // Team statistics
    match /teamStatistics/{teamId} {
      allow read, write: if request.auth != null;
    }

    // Players
    match /players/{playerId} {
      allow read, write: if request.auth != null;
    }

    // Matches
    match /matches/{matchId} {
      allow read, write: if request.auth != null;
    }

    // News — anyone authenticated can read, write for seeding
    match /news/{newsId} {
      allow read, write: if request.auth != null;
    }

    // Championships
    match /championships/{championshipId} {
      allow read, write: if request.auth != null;
    }
  }
}
